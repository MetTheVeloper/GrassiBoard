{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 Release (ABI 9 / Remote Monitor)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64-release",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "BUILD_TESTING": "ON",
        "GRASSIBOARD_REMOTE_MONITOR_TAP": "ON"
      }
    },
    {
      "name": "windows-x64-remote-monitor-spike",
      "displayName": "Windows x64 Remote Monitor ABI-9 Compatibility",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-x64-remote-monitor-spike",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "BUILD_TESTING": "ON",
        "GRASSIBOARD_REMOTE_MONITOR_TAP": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-remote-monitor-spike",
      "configurePreset": "windows-x64-remote-monitor-spike",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-x64-remote-monitor-spike",
      "configurePreset": "windows-x64-remote-monitor-spike",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
