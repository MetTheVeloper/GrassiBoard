<Application x:Class="GrassiBoard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0B0F14" />
        <SolidColorBrush x:Key="PanelBrush" Color="#151C25" />
        <SolidColorBrush x:Key="TextBrush" Color="#F2F5F8" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#91A0B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#75E6B5" />
    </Application.Resources>
</Application>
