<Window x:Class="GrassiBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrassiBoard" Height="720" Width="1100"
        MinHeight="650" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GRASSIBOARD" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Microphone passthrough" FontSize="30" FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                    <TextBlock Text="Milestone 1 · Physical microphone to headset monitoring"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="VersionText" Text="v0.2.0" FontSize="18" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CommitText" Text="local" FontFamily="Consolas" FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0"
                               HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="INPUT MICROPHONE" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Grid.Column="2" Text="MONITOR OUTPUT" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox x:Name="InputDeviceCombo" Grid.Row="2" MinWidth="300"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <ComboBox x:Name="MonitorDeviceCombo" Grid.Row="2" Grid.Column="2" MinWidth="300"
                              DisplayMemberPath="Name" SelectedValuePath="Id" />
                    <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal">
                        <Button x:Name="RefreshButton" Content="Refresh" Click="RefreshButton_Click"
                                Background="#D7E1EC" Margin="0,0,10,0" />
                        <Button x:Name="StartStopButton" Content="Start engine" Click="StartStopButton_Click"
                                MinWidth="130" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="#211A12" BorderBrush="#735E35" BorderThickness="1"
                    CornerRadius="9" Padding="14">
                <TextBlock Foreground="#F4D899" TextWrapping="Wrap">
                    Start with a low headset volume. Live microphone monitoring can be loud and may create feedback
                    if speakers are used instead of headphones.
                </TextBlock>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MICROPHONE INPUT" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="InputDbText" Text="−∞ dBFS" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
                        </Grid>
                        <ProgressBar x:Name="InputMeter" Minimum="0" Maximum="100" Margin="0,16,0,0" />
                        <TextBlock Text="Peak level received from the selected microphone"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MONITOR OUTPUT" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="OutputDbText" Text="−∞ dBFS" HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="Consolas" />
                        </Grid>
                        <ProgressBar x:Name="OutputMeter" Minimum="0" Maximum="100" Margin="0,16,0,0" />
                        <TextBlock Text="Peak level written to the selected headset"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="7" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ENGINE STATUS" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse x:Name="NativeStatusDot" Width="10" Height="10" Fill="#91A0B3" Margin="0,5,10,0" />
                            <TextBlock x:Name="NativeStatusText" Text="Loading native engine…" FontSize="15" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="BUFFER FRAMES" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="BufferText" Text="Capture — · Render —" FontFamily="Consolas"
                                   FontSize="14" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="RING FILL" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="RingFillText" Text="— frames" FontFamily="Consolas"
                                   FontSize="14" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="DROPOUTS" FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock x:Name="DropoutText" Text="U 0 · O 0 · D 0" FontFamily="Consolas"
                                   FontSize="14" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
