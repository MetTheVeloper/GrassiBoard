<Window x:Class="GrassiBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GrassiBoard.Views"
        Title="GrassiBoard" Height="800" Width="1280"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="GRASSIBOARD" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Audio workspace" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Content="▦   Board" Command="{Binding NavigateCommand}" CommandParameter="Board">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBoardPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="≋   Voice" Command="{Binding NavigateCommand}" CommandParameter="Voice">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoicePage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⇄   Routing" Command="{Binding NavigateCommand}" CommandParameter="Routing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoutingPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="⚙   Settings" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="{StaticResource PanelQuietBrush}" CornerRadius="9" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Version}" FontSize="14" />
                        <TextBlock Text="{Binding Commit}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="80" />
                <RowDefinition Height="96" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="210" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,4,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NativeReady}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineDetail}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11" Margin="18,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="MIC" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MicrophoneDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding MicrophoneMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="BOARD" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding SoundboardDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding SoundboardMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="MASTER" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MasterDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{StaticResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding MasterMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding MuteButtonLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleMuteCommand}" Margin="0,0,10,0" MinWidth="104" />
                        <Button Content="Stop All" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding StopAllCommand}" MinWidth="92" ToolTip="Stop all Sound Pads; microphone stays live" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,10">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource PanelQuietBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="{Binding EngineStateLabel}" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="28,0,28,24">
                <views:BoardView Visibility="{Binding IsBoardPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:VoiceView Visibility="{Binding IsVoicePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:RoutingView Visibility="{Binding IsRoutingPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
