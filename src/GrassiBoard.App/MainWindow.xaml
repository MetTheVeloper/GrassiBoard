<Window x:Class="GrassiBoard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:GrassiBoard.Views"
        Title="GrassiBoard" Height="800" Width="1280"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource PageBrush}"
        Foreground="{DynamicResource TextBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="WindowFrame" BorderBrush="{DynamicResource BorderBrush}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Value="Maximized">
                        <Setter Property="BorderThickness" Value="0" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5"
                            Background="{DynamicResource AccentDarkBrush}">
                        <TextBlock Text="G" Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="Bold" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="GrassiBoard" FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ThemeToggleButton" Content="&#xE706;" Style="{StaticResource TitleBarButtonStyle}"
                            AutomationProperties.Name="Toggle color theme"
                            Click="OnThemeToggleClick" ToolTip="Switch to light theme" />
                    <Button Content="&#xE921;" Style="{StaticResource TitleBarButtonStyle}" AutomationProperties.Name="Minimize"
                            Click="OnMinimizeClick" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource TitleBarButtonStyle}"
                            AutomationProperties.Name="Maximize or restore"
                            Click="OnMaximizeRestoreClick" ToolTip="Maximize" />
                    <Button Content="&#xE8BB;" Style="{StaticResource TitleBarCloseButtonStyle}" AutomationProperties.Name="Close"
                            Click="OnCloseClick" ToolTip="Close" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="188" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="GRASSIBOARD" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Audio workspace" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="11" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Board" AutomationProperties.Name="Board">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBoardPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE80A;" Style="{StaticResource GbIconTextStyle}" Width="22" />
                            <TextBlock Text="Board" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Voice" AutomationProperties.Name="Voice">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVoicePage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE720;" Style="{StaticResource GbIconTextStyle}" Width="22" />
                            <TextBlock Text="Voice" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Mixer" AutomationProperties.Name="Mixer">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMixerPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource GbIconTextStyle}" Width="22" />
                            <TextBlock Text="Mixer" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Routing" AutomationProperties.Name="Routing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRoutingPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8AB;" Style="{StaticResource GbIconTextStyle}" Width="22" />
                            <TextBlock Text="Routing" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource GbIconTextStyle}" Width="22" />
                            <TextBlock Text="Settings" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Grid.Row="4" Background="{DynamicResource PanelQuietBrush}" CornerRadius="9" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{Binding Version}" FontSize="14" />
                        <TextBlock Text="{Binding Commit}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="90" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{DynamicResource TopBarBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="24,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" MinWidth="210" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,4,9,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource MutedTextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NativeReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding EngineStatus}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding EngineDetail}" Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" Margin="18,5,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="MIC" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MicrophoneDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{DynamicResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding MicrophoneMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="BOARD" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding SoundboardDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{DynamicResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding SoundboardMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="5" VerticalAlignment="Center">
                        <Grid Margin="0,0,0,5">
                            <TextBlock Text="MASTER" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MasterDb}" HorizontalAlignment="Right" FontSize="9"
                                       Foreground="{DynamicResource MutedTextBrush}" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <ProgressBar Value="{Binding MasterMeter, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding MuteButtonLabel}" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ToggleMuteCommand}" Margin="0,0,10,0" MinWidth="104" />
                        <Button Content="Stop All" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding StopAllCommand}" MinWidth="92"
                                ToolTip="Stop every Sound Pad and the audio engine" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,18,24,10">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource PanelQuietBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <TextBlock Text="{Binding EngineStateLabel}" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="24,0,24,24">
                <views:BoardView Visibility="{Binding IsBoardPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:VoiceView Visibility="{Binding IsVoicePage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:MixerView Visibility="{Binding IsMixerPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:RoutingView Visibility="{Binding IsRoutingPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:SettingsView Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
