<UserControl x:Class="GrassiBoard.Views.VoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <Grid>
                <StackPanel>
                    <TextBlock Text="VOICE PROCESSING" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Microphone character" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding VoiceFxLabel}" Command="{Binding ToggleVoiceFxCommand}" Margin="0,0,10,0" />
                    <Button Content="Reset Voice" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetVoiceCommand}" />
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PITCH" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding PitchLabel}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding Pitch, Mode=TwoWay}" Margin="0,13,0,0" />
                        <TextBlock Text="Move the speaking voice by whole semitones."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid>
                            <TextBlock Text="FINE PITCH" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding FinePitchLabel}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-100" Maximum="100" TickFrequency="1"
                                Value="{Binding FinePitch, Mode=TwoWay}" Margin="0,13,0,0" />
                        <TextBlock Text="Tune between semitones without changing speaking speed."
                                   Style="{StaticResource MutedTextStyle}" Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="FORMANT SHIFT" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding FormantLabel}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Value="{Binding Formant, Mode=TwoWay}" Margin="0,13,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource PanelQuietBrush}" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <CheckBox Content="Preserve vocal character"
                                      IsChecked="{Binding PreserveVocalCharacter, Mode=TwoWay}" />
                            <TextBlock Text="Compensates vocal character while Pitch changes."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Expander Header="Advanced" Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" IsExpanded="False">
                <Border Style="{StaticResource CardStyle}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUALITY MODE" Style="{StaticResource EyebrowTextStyle}" />
                            <ComboBox SelectedIndex="{Binding QualityIndex, Mode=TwoWay}" Margin="0,9,0,0">
                                <ComboBoxItem Content="Low latency" />
                                <ComboBoxItem Content="Balanced (default)" />
                                <ComboBoxItem Content="High quality" />
                            </ComboBox>
                            <TextBlock Text="Changes use a live crossfade and do not restart the stream."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="LIVE DSP LATENCY" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding PitchLatencyMilliseconds, StringFormat={}{0:0.0} ms}"
                                       FontSize="24" FontFamily="{StaticResource MonoFont}" Margin="0,10,0,0" />
                            <TextBlock Text="Reported by the active pitch backend."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
