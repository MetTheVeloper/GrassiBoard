<UserControl x:Class="GrassiBoard.Views.Looper.LooperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:looper="clr-namespace:GrassiBoard.Views.Looper">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GRASSILOOPER" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Looper" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                    <TextBlock Text="Gate 4 child layers · Gate 3 processed microphone capture preserved"
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button x:Name="NewProjectButton" Content="New project" Click="OnNewProjectClick"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="28"
                    Visibility="{Binding IsEmptyProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="620" Margin="20,40">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SelectedSurfaceBrush}">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="23"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="New Loop Project" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Import a base audio file, or record a free first Master from the currently selected GrassiBoard microphone source."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" Margin="0,8,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="ImportAudioButton" Content="Import Audio" Command="{Binding ImportAudioCommand}" MinWidth="132" Margin="0,0,10,0" />
                        <Button x:Name="RecordFirstLoopButton" Content="Record First Loop" Click="OnRecordFirstLoopClick"
                                MinWidth="160" />
                    </StackPanel>
                    <TextBlock x:Name="RecordStatusText"
                               Text="Processed Voice FX are printed into the Take. The live microphone is recorded but not locally monitored."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16"
                    Visibility="{Binding HasPendingImport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="MASTER TRIM EDITOR" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding PendingFileName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingDurationLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>

                    <Border Margin="0,16,0,0" Height="230" CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <looper:WaveformView x:Name="PendingWaveformEditor"
                                             WaveformData="{Binding PendingWaveform}"
                                             PlayheadPosition="{Binding PendingPlayheadPosition}"
                                             SelectionStart="{Binding SelectionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SelectionEnd="{Binding SelectionEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEditable="True" IsSeekable="True" ShowTrimHandles="True"
                                             SeekCommand="{Binding AuditionSeekCommand}" />
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="{Binding SelectionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="−" Width="38" ToolTip="Zoom out" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnZoomOutClick" Margin="0,0,6,0" />
                            <Button Content="+" Width="38" ToolTip="Zoom in" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnZoomInClick" Margin="0,0,6,0" />
                            <Button Content="Fit selection" ToolTip="Zoom to the current START / END" Style="{StaticResource SecondaryButtonStyle}"
                                    Click="OnFitSelectionClick" Margin="0,0,8,0" />
                            <Button Content="{Binding AuditionPlayPauseLabel}" Command="{Binding AuditionPlayPauseCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="112" Margin="0,0,8,0" />
                            <Button Content="Cancel" Command="{Binding CancelImportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="{Binding SetMasterActionLabel}" Command="{Binding SetAsMasterCommand}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Click or drag the white playhead to audition any point · mouse wheel zooms · Shift+drag or middle-drag pans · yellow lines are START / END."
                               Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,9,0,0" />
                    <TextBlock Text="Changing START or END resets audition to the new START; active playback restarts after the trim gesture settles."
                               Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding EngineRequirementLabel}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasMaster, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="MASTER LOOP" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding Master.SourceFileName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MasterDurationLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Text="{Binding MasterFrameLabel}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="96" Margin="0,14,0,0" CornerRadius="7" ClipToBounds="True">
                            <looper:WaveformView WaveformData="{Binding Master.Waveform}"
                                                 WaveformColor="{Binding Master.DisplayColor}"
                                                 PlayheadPosition="{Binding MasterPlayheadPosition}"
                                                 CompactMode="True" />
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{Binding TransportPlayPauseLabel}" Click="OnTransportPlayPauseClick"
                                        MinWidth="92" Margin="0,0,8,0" />
                                <Button Content="Stop" Click="OnTransportStopClick"
                                        Style="{StaticResource SecondaryButtonStyle}" MinWidth="82" />
                                <TextBlock Text="{Binding MasterPositionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="14,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="EditMasterButton" Content="Edit Master" Command="{Binding EditMasterCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                <Button x:Name="ImportDifferentMasterButton" Content="Import different Master" Command="{Binding ImportAudioCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="MONITOR OUTPUT" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="LooperMonitorOutputCombo" MinWidth="300" MaxWidth="430"
                                          SelectionChanged="OnMonitorOutputSelectionChanged" />
                            </StackPanel>
                            <TextBlock Text="Shared with Media Deck monitor" Style="{StaticResource MutedTextStyle}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding EngineRequirementLabel}" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding MonitorRouteLabel}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding LoopSafetyLabel}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding MonitorDiagnosticsLabel}" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                            <TextBlock Text="One native sample clock · child buffers are exactly Master-length."
                                       Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TRACKS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Layers" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="AddLayerButton" Content="Add Layer" Click="OnAddLayerClick"
                            HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="110" />
                </Grid>

                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="ACTIVE LAYER" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock x:Name="ActiveLayerNameText" Text="Select a layer" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="END OF LOOP" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="LayerModeCombo" Width="220" SelectionChanged="OnLayerModeChanged">
                                    <ComboBoxItem Content="One Cycle · Stop Recording" />
                                    <ComboBoxItem Content="Loop Replace · Replace From Start" />
                                    <ComboBoxItem Content="Overdub · Overdub From Start" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LayerRecordButton" Content="Record Layer" Click="OnLayerRecordClick" MinWidth="120" />
                                <Button x:Name="LayerCancelButton" Content="Cancel / Discard" Click="OnLayerCancelClick"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="False" />
                                <Button x:Name="LayerUndoButton" Content="Undo" Click="OnLayerUndoClick"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" IsEnabled="False" />
                                <Button x:Name="DeleteLayerButton" Content="Delete Layer" Click="OnDeleteLayerClick"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Record mid-cycle → ARMED → starts at next Master boundary"
                                       Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="LayerRecordStatusText"
                                   Text="Add or select a layer, choose a mode, then Record Layer. Live mic monitoring stays OFF."
                                   Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <ListBox x:Name="TrackListBox" ItemsSource="{Binding Project.Tracks}" SelectionChanged="OnTrackSelectionChanged"
                         Background="Transparent" BorderThickness="0" Padding="0" Margin="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <looper:LooperTrackRow />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" Margin="2,14,2,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
