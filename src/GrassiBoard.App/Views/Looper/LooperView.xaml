<UserControl x:Class="GrassiBoard.Views.Looper.LooperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:looper="clr-namespace:GrassiBoard.Views.Looper">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Grid Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="GRASSILOOPER" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Looper" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                    <TextBlock Text="Sample-accurate Master Loop workspace · Gate 1 foundation"
                               Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="New project" Command="{Binding NewProjectCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <Border Style="{StaticResource CardStyle}" Padding="28"
                    Visibility="{Binding IsEmptyProject, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" MaxWidth="560" Margin="20,44">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SelectedSurfaceBrush}">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="23"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="New Loop Project" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Import a base audio file now, or build the first Master from microphone when Gate 3 unlocks recording."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" Margin="0,8,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Import Audio" Command="{Binding ImportAudioCommand}" MinWidth="132" Margin="0,0,10,0" />
                        <Button Content="Record First Loop" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="150" ToolTip="Microphone Master recording is intentionally locked until Gate 3." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16"
                    Visibility="{Binding HasPendingImport, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="IMPORTED MASTER" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding PendingFileName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding PendingDurationLabel}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource MutedTextBrush}" />
                    </Grid>
                    <Border Margin="0,16,0,0" Height="210" CornerRadius="8" ClipToBounds="True" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <looper:WaveformView WaveformData="{Binding PendingWaveform}"
                                             SelectionStart="{Binding SelectionStart, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             SelectionEnd="{Binding SelectionEnd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEditable="True" ShowTrimHandles="True" />
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <TextBlock Text="{Binding SelectionLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CancelImportCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                            <Button Content="Set As Master Loop" Command="{Binding SetAsMasterCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasMaster, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="MASTER LOOP" Style="{StaticResource EyebrowTextStyle}" />
                                <TextBlock Text="{Binding Master.SourceFileName}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right">
                                <TextBlock Text="{Binding MasterDurationLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                                <TextBlock Text="{Binding MasterFrameLabel}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontSize="10" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="82" Margin="0,14,0,0" CornerRadius="7" ClipToBounds="True">
                            <looper:WaveformView WaveformData="{Binding Master.Waveform}"
                                                 WaveformColor="{Binding Master.DisplayColor}"
                                                 CompactMode="True" />
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Master length is sample-defined; BPM is not the project clock."
                                       Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                            <Button Content="Import different Master" Command="{Binding ImportAudioCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="TRACKS" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="Layers" Style="{StaticResource SectionTitleStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                    <TextBlock Text="Recording unlocks in Gate 4" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Project.Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <looper:LooperTrackRow />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource CardStyle}" Padding="22"
                        Visibility="{Binding HasChildTracks, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="No child layers yet. Gate 1 intentionally stops before the multi-track recording engine."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource MutedTextStyle}" Margin="2,14,2,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
