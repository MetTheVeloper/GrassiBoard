<UserControl x:Class="GrassiBoard.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Left">
            <TextBlock Text="AUDIO ROUTING" Style="{StaticResource EyebrowTextStyle}" />
            <TextBlock Text="Physical in, virtual out" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="INPUT MICROPHONE" Style="{StaticResource EyebrowTextStyle}" />
                        <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding SelectedInput}"
                                  IsEnabled="{Binding CanConfigureRouting}" Margin="0,9,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="The physical microphone GrassiBoard captures and processes."
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="VIRTUAL MICROPHONE OUTPUT" Style="{StaticResource EyebrowTextStyle}" />
                        <ComboBox ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedOutput}"
                                  IsEnabled="{Binding CanConfigureRouting}" Margin="0,9,0,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Processed voice and Sound Pads are sent together to this route."
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{DynamicResource SuccessBrush}" Margin="0,1,9,0" />
                            <TextBlock Text="{Binding VirtualMicrophoneStatus}" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VirtualMicrophoneHint}" Style="{StaticResource MutedTextStyle}"
                                   Margin="0,7,20,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshDevicesCommand}"
                                Margin="0,0,10,0" ToolTip="Scan audio devices again">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource GbIconTextStyle}" Margin="0,0,7,0" />
                                <TextBlock Text="Refresh" />
                            </StackPanel>
                        </Button>
                        <Button Content="{Binding EngineButtonLabel}" Command="{Binding StartStopCommand}" MinWidth="130">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource DangerDarkBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource PanelQuietBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="HOW TO USE THE VIRTUAL MICROPHONE" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Start the engine here. Then, in Telegram, OBS, a recorder, game, or another target app, select the paired recording endpoint named above as its microphone."
                               Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="Raw cable endpoint names remain visible here for setup and in Settings → Diagnostics."
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
