<UserControl x:Class="GrassiBoard.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="520" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="280" MaxWidth="390" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="16">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="MEDIA DECK" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MediaFileName}" FontSize="16" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding MediaFileName}" Margin="0,4,170,0" />
                            <TextBlock Text="{Binding MediaError}" Foreground="{DynamicResource DangerBrush}" FontSize="10"
                                       Visibility="{Binding MediaHasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="Load media" Command="{Binding LoadMediaCommand}" Margin="0,0,8,0" />
                            <Button Content="Clear" Command="{Binding ClearMediaCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,13,0,0" IsEnabled="{Binding HasMedia}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" /><ColumnDefinition Width="8" />
                            <ColumnDefinition Width="70" /><ColumnDefinition Width="8" />
                            <ColumnDefinition Width="36" /><ColumnDefinition Width="8" />
                            <ColumnDefinition Width="36" /><ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="-10" Command="{Binding MediaBackCommand}" Style="{StaticResource GbTransportButtonStyle}" ToolTip="Seek back 10 seconds" />
                        <Button Grid.Column="2" Content="{Binding MediaPlayPauseLabel}" Command="{Binding MediaPlayPauseCommand}" />
                        <Button Grid.Column="4" Content="■" Command="{Binding MediaStopCommand}" Style="{StaticResource GbTransportButtonStyle}" ToolTip="Stop and return to 00:00" />
                        <Button Grid.Column="6" Content="+10" Command="{Binding MediaForwardCommand}" Style="{StaticResource GbTransportButtonStyle}" ToolTip="Seek forward 10 seconds" />
                        <StackPanel Grid.Column="8">
                            <TextBlock Text="{Binding MediaTimeLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="10" />
                            <Slider Minimum="0" Maximum="{Binding MediaDuration}" Value="{Binding MediaPosition, Mode=TwoWay}"
                                    Margin="0,3,0,0" ToolTip="Media timeline" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" /><ColumnDefinition Width="150" /><ColumnDefinition Width="46" />
                            <ColumnDefinition Width="22" /><ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="VOL" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="1.5" Value="{Binding MediaVolume, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding MediaVolumeLabel}" FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <WrapPanel Grid.Column="4" VerticalAlignment="Center">
                            <CheckBox Content="Monitor in headphones" IsChecked="{Binding MediaMonitorEnabled, Mode=TwoWay}" Margin="0,0,24,6" />
                            <CheckBox Content="Send to virtual mic" IsChecked="{Binding MediaSendEnabled, Mode=TwoWay}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="MONITOR DEVICE" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputDevices}" SelectedItem="{Binding SelectedMonitorOutput, Mode=TwoWay}"
                                  DisplayMemberPath="Name" Margin="12,0" ToolTip="Only Media Deck audio is sent here; your microphone is never monitored." />
                        <StackPanel Grid.Column="2" Width="120">
                            <TextBlock Text="{Binding MediaDb}" FontFamily="{StaticResource MonoFont}" FontSize="10" HorizontalAlignment="Right" />
                            <ProgressBar Value="{Binding MediaMeter, Mode=OneWay}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <StackPanel>
                    <TextBlock Text="SOUNDBOARD" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Sounds" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding AddPadsCommand}"
                        AutomationProperties.Name="Add sounds"
                        ToolTip="Add WAV or MP3 files to the board">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" Style="{StaticResource GbIconTextStyle}" Margin="0,0,8,0" />
                        <TextBlock Text="Add sounds" Foreground="#07110D" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="4" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasPads, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <Border Width="50" Height="50" CornerRadius="25" Background="{DynamicResource SelectedSurfaceBrush}">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Build your first board" FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="Add WAV or MP3 files, or drop them anywhere in this workspace. Files stay in their original folders."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" Margin="0,8,0,18" />
                    <Button Content="Choose audio files" Command="{Binding AddPadsCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasPads, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Pads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel IsItemsHost="True" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="PadCard" ToolTip="{Binding Error}">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource GbSoundPadCardStyle}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverSurfaceBrush}" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SelectedSurfaceBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource DangerDarkBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Opacity" Value="0.58" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="32" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="36" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="22" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="32" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse ToolTip="Ready">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource GbStatusDotStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Stroke" Value="{DynamicResource TextBrush}" />
                                                            <Setter Property="StrokeThickness" Value="1" />
                                                            <Setter Property="ToolTip" Value="Playing" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasError}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                                            <Setter Property="ToolTip" Value="Needs attention" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                                            <Setter Property="ToolTip" Value="Loading" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
                                            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" FontSize="9"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource GbIconButtonStyle}" AutomationProperties.Name="Edit sound"
                                                Command="{Binding DataContext.EditPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Edit sound">
                                            <TextBlock Text="&#xE712;" Style="{StaticResource GbIconTextStyle}" />
                                        </Button>
                                        <Button Grid.Column="3" Style="{StaticResource GbIconButtonStyle}" Foreground="{DynamicResource DangerBrush}"
                                                AutomationProperties.Name="Remove sound"
                                                Command="{Binding DataContext.DeletePadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Remove sound">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource GbIconTextStyle}" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="&#xE768;" AutomationProperties.Name="Play sound"
                                                Command="{Binding DataContext.PlayPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Play sound">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource GbTransportButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="#07110D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="2" Content="&#xE71A;" Style="{StaticResource GbTransportButtonStyle}"
                                                AutomationProperties.Name="Stop sound"
                                                IsEnabled="{Binding IsPlaying}"
                                                Command="{Binding DataContext.StopPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Stop sound" />
                                        <CheckBox Grid.Column="4" Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}"
                                                  VerticalAlignment="Center" ToolTip="Repeat until stopped" />
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VOL" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                                Margin="10,0" VerticalAlignment="Center" ToolTip="Pad volume" />
                                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="VOICE FX" Style="{StaticResource EyebrowTextStyle}" />
                <Grid Margin="0,10,0,22">
                    <StackPanel>
                        <TextBlock Text="Live voice" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Sound Pads always bypass these effects." Style="{StaticResource MutedTextStyle}"
                                   FontSize="11" Margin="0,4,90,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" MinWidth="90"
                            Content="{Binding VoiceFxLabel}" Command="{Binding ToggleVoiceFxCommand}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PITCH" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding PitchLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                </Grid>
                <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Pitch, Mode=TwoWay}" ToolTip="Voice pitch" />

                <Grid Margin="0,22,0,8">
                    <TextBlock Text="FORMANT" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding FormantLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                </Grid>
                <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding Formant, Mode=TwoWay}" ToolTip="Voice formant" />

                <Button Content="Reset voice" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetVoiceCommand}" Margin="0,24,0,0" />

                <Border Background="{DynamicResource PanelQuietBrush}" CornerRadius="9" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="QUICK LEVELS" Style="{StaticResource EyebrowTextStyle}" />
                        <Grid Margin="0,12,0,5">
                            <TextBlock Text="Mic" />
                            <TextBlock Text="{Binding MicrophoneDb}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding MicrophoneMeter, Mode=OneWay}" />
                        <Grid Margin="0,14,0,5">
                            <TextBlock Text="Soundboard" />
                            <TextBlock Text="{Binding SoundboardDb}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding SoundboardMeter, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
