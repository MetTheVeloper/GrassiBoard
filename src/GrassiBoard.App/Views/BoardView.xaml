<UserControl x:Class="GrassiBoard.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" MinWidth="520" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" MinWidth="280" MaxWidth="390" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="SOUNDBOARD" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Sounds" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="＋ Add sounds" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding AddPadsCommand}" />
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}"
                    Visibility="{Binding HasPads, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="＋" FontSize="42" Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Build your first board" FontSize="21" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Add WAV or MP3 files, or drop them anywhere in this workspace. Files stay in their original folders."
                               Style="{StaticResource MutedTextStyle}" TextAlignment="Center" Margin="0,8,0,18" />
                    <Button Content="Choose audio files" Command="{Binding AddPadsCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasPads, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding Pads}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="PadCard" Width="242" MinHeight="206" Margin="0,0,12,12"
                                    CornerRadius="12" Padding="16"
                                    ToolTip="{Binding Error}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter Property="Background" Value="#142A25" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource DangerDarkBrush}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                                <Setter Property="Opacity" Value="0.64" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding StateLabel}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Content="•••" Style="{StaticResource GhostButtonStyle}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Command="{Binding DataContext.EditPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" ToolTip="Edit Sound Pad" />
                                    </Grid>

                                    <Button Grid.Row="1" Margin="0,12,0" MinHeight="66" FontSize="15"
                                            Content="▶  Play"
                                            Command="{Binding DataContext.PlayPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                        <Setter Property="Content" Value="▶  Playing" />
                                                        <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>

                                    <Grid Grid.Row="2" Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="VOL" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                                                Margin="10,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:P0}}"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>

                                    <Grid Grid.Row="3">
                                        <CheckBox Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Stop" Style="{StaticResource GhostButtonStyle}"
                                                    Command="{Binding DataContext.StopPadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Remove" Style="{StaticResource GhostButtonStyle}"
                                                    Foreground="{StaticResource DangerBrush}"
                                                    Command="{Binding DataContext.DeletePadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="VOICE FX" Style="{StaticResource EyebrowTextStyle}" />
                <Grid Margin="0,10,0,22">
                    <StackPanel>
                        <TextBlock Text="Live voice" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Sound Pads always bypass these effects."
                                   Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,4,80,0" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                            Content="{Binding VoiceFxLabel}" Command="{Binding ToggleVoiceFxCommand}" />
                </Grid>

                <Grid Margin="0,0,0,8">
                    <TextBlock Text="PITCH" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding PitchLabel}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" />
                </Grid>
                <Slider Minimum="-12" Maximum="12" TickFrequency="1" IsSnapToTickEnabled="True"
                        Value="{Binding Pitch, Mode=TwoWay}" />

                <Grid Margin="0,22,0,8">
                    <TextBlock Text="FORMANT" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{Binding FormantLabel}" HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}" />
                </Grid>
                <Slider Minimum="-12" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True"
                        Value="{Binding Formant, Mode=TwoWay}" />

                <Button Content="Reset Voice" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ResetVoiceCommand}" Margin="0,24,0,0" />

                <Border Background="{StaticResource PanelQuietBrush}" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="QUICK LEVELS" Style="{StaticResource EyebrowTextStyle}" />
                        <Grid Margin="0,12,0,5">
                            <TextBlock Text="Mic" />
                            <TextBlock Text="{Binding MicrophoneDb}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding MicrophoneMeter, Mode=OneWay}" />
                        <Grid Margin="0,14,0,5">
                            <TextBlock Text="Soundboard" />
                            <TextBlock Text="{Binding SoundboardDb}" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11" />
                        </Grid>
                        <ProgressBar Value="{Binding SoundboardMeter, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
