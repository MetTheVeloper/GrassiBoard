<UserControl x:Class="GrassiBoard.Views.MixerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <Grid>
                <StackPanel>
                    <TextBlock Text="MIXER &amp; DYNAMICS" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Live output control" Style="{StaticResource SectionTitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox SelectedIndex="{Binding PresetIndex, Mode=TwoWay}" Width="180" Margin="0,0,10,0"
                              ToolTip="Choose a built-in audio preset">
                        <ComboBoxItem Content="Custom" />
                        <ComboBoxItem Content="Clean" />
                        <ComboBoxItem Content="Broadcast" />
                        <ComboBoxItem Content="Streaming" />
                        <ComboBoxItem Content="Voice chat" />
                    </ComboBox>
                    <Button Content="Apply preset" Command="{Binding ApplyPresetCommand}" Margin="0,0,10,0" />
                    <Button Content="Reset mixer" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ResetMixerCommand}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MIC GAIN" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MicGainLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-24" Maximum="24" Value="{Binding MicGain, Mode=TwoWay}"
                                Margin="0,14,0,0" ToolTip="Microphone bus gain" />
                        <ProgressBar Value="{Binding MicrophoneMeter, Mode=OneWay}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="SOUNDBOARD GAIN" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding SoundboardGainLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-24" Maximum="24" Value="{Binding SoundboardGain, Mode=TwoWay}"
                                Margin="0,14,0,0" ToolTip="Soundboard bus gain" />
                        <ProgressBar Value="{Binding SoundboardMeter, Mode=OneWay}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="MASTER GAIN" Style="{StaticResource EyebrowTextStyle}" />
                            <TextBlock Text="{Binding MasterGainLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" />
                        </Grid>
                        <Slider Minimum="-24" Maximum="12" Value="{Binding MasterGain, Mode=TwoWay}"
                                Margin="0,14,0,0" ToolTip="Final output gain" />
                        <ProgressBar Value="{Binding MasterMeter, Mode=OneWay}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <CheckBox Content="Noise Gate" IsChecked="{Binding NoiseGateEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Closes the microphone path below the selected threshold."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,7,0,14" />
                            <Grid><TextBlock Text="THRESHOLD" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding GateThresholdLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="-80" Maximum="-20" Value="{Binding GateThreshold, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Content="Compressor" IsChecked="{Binding CompressorEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Reduces microphone peaks above the threshold."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,7,0,14" />
                            <Grid><TextBlock Text="THRESHOLD" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding CompressorThresholdLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="-40" Maximum="-3" Value="{Binding CompressorThreshold, Mode=TwoWay}" Margin="0,10,0,14" />
                            <Grid><TextBlock Text="RATIO" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding CompressorRatioLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="1" Maximum="20" Value="{Binding CompressorRatio, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid><TextBlock Text="PITCH WET / DRY" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding PitchWetMixLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="0" Maximum="100" Value="{Binding PitchWetMix, Mode=TwoWay}" Margin="0,10,0,0" />
                            <TextBlock Text="Blends latency-aligned original voice with Pitch/Formant processing."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <CheckBox Content="Ducking" IsChecked="{Binding DuckingEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Lowers the Soundboard bus automatically while you speak."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,7,0,14" />
                            <Grid><TextBlock Text="REDUCTION" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding DuckingAmountLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="0" Maximum="30" Value="{Binding DuckingAmount, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Content="Limiter" IsChecked="{Binding LimiterEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Controls final mixed peaks with fast attack and smooth release."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,7,0,14" />
                            <Grid><TextBlock Text="CEILING" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding LimiterCeilingLabel}" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" /></Grid>
                            <Slider Minimum="-12" Maximum="0" Value="{Binding LimiterCeiling, Mode=TwoWay}" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <CheckBox Content="Clipping Protection" IsChecked="{Binding ClippingProtectionEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Applies a final soft safety curve before samples reach the virtual output."
                                       Style="{StaticResource MutedTextStyle}" FontSize="11" Margin="0,7,0,0" />
                            <Border Background="{DynamicResource PanelQuietBrush}" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                                <TextBlock Text="Signal order: Voice DSP → Mic dynamics + Soundboard ducking → Master → Limiter → protection"
                                           Style="{StaticResource MutedTextStyle}" FontSize="11" />
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
