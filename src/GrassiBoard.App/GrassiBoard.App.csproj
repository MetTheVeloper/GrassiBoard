<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GrassiBoard</AssemblyName>
    <RootNamespace>GrassiBoard</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\GrassiBoard.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRemoteMonitorSpike)' == 'true'">
    <DefineConstants>$(DefineConstants);REMOTE_MONITOR_SPIKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableRemoteMonitorSpike)' == 'true'">
    <!-- v1.2 technology-spike dependency only. The original SpawnDev.SIPSorcery
         candidate did not expose Opus through AudioEncoder in the real-device test.
         This official SIPSorcery candidate includes managed Opus via Concentus.
         Do not enable for release builds until the real-device WebRTC test and
         license gate are explicitly accepted. -->
    <PackageReference Include="SIPSorcery" Version="10.0.13" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\GrassiBoard.Shared\GrassiBoard.Shared.csproj" />
    <Resource Include="Assets\GrassiBoard.ico" />
    <Resource Include="Assets\GrassiBoard.png" />
    <Content Include="BuildInfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\GrassiBoard.RemoteWeb\.output\public\**\*"
             Condition="Exists('..\GrassiBoard.RemoteWeb\.output\public\index.html')"
             Link="RemoteWeb\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
