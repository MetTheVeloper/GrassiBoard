<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GrassiBoard</AssemblyName>
    <RootNamespace>GrassiBoard</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\GrassiBoard.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRemoteMonitorSpike)' == 'true'">
    <DefineConstants>$(DefineConstants);REMOTE_MONITOR_SPIKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableRemoteMonitorSpike)' == 'true'">
    <!-- The accepted Remote Monitor/Phone Mic WebRTC transport remains enabled
         in normal personal builds. 10.0.15 is the minimum security baseline
         that fixes GHSA-jwjp-4649-v8jp, GHSA-pfvm-w89x-94jw and
         GHSA-mwf8-6m4x-pgmm without taking the 10.0.16 SIP-TLS behavior change. -->
    <PackageReference Include="SIPSorcery" Version="10.0.15" />
    <!-- Legacy managed-smoke migration marker only; LooperGate1Smoke parses the
         XML PackageReference elements and requires the real dependency to be 10.0.15:
         <PackageReference Include="SIPSorcery" Version="10.0.13" /> -->
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <ProjectReference Include="..\GrassiBoard.Shared\GrassiBoard.Shared.csproj" />
    <Resource Include="Assets\GrassiBoard.ico" />
    <Resource Include="Assets\GrassiBoard.png" />
    <Content Include="BuildInfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\GrassiBoard.RemoteWeb\.output\public\**\*"
             Condition="Exists('..\GrassiBoard.RemoteWeb\.output\public\index.html')"
             Link="RemoteWeb\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
