<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Color x:Key="PageColor">#090E13</Color>
    <Color x:Key="SidebarColor">#0C1219</Color>
    <Color x:Key="PanelColor">#131C26</Color>
    <Color x:Key="PanelRaisedColor">#182431</Color>
    <Color x:Key="PanelQuietColor">#0E161F</Color>
    <Color x:Key="TopBarColor">#0B1118</Color>
    <Color x:Key="ElevatedCardColor">#17222E</Color>
    <Color x:Key="ControlSurfaceColor">#101923</Color>
    <Color x:Key="HoverSurfaceColor">#1D2B38</Color>
    <Color x:Key="PressedSurfaceColor">#243746</Color>
    <Color x:Key="SelectedSurfaceColor">#163D32</Color>
    <Color x:Key="BorderColor">#263746</Color>
    <Color x:Key="TextColor">#F4F7F9</Color>
    <Color x:Key="MutedTextColor">#93A7BA</Color>
    <Color x:Key="AccentColor">#76E7B7</Color>
    <Color x:Key="AccentDarkColor">#163D32</Color>
    <Color x:Key="SuccessColor">#76E7B7</Color>
    <Color x:Key="WarningColor">#F2CF72</Color>
    <Color x:Key="DangerColor">#FF7C92</Color>
    <Color x:Key="DangerDarkColor">#47232C</Color>
    <Color x:Key="MeterTrackColor">#243442</Color>
    <Color x:Key="DisabledColor">#607080</Color>

    <SolidColorBrush x:Key="PageBrush" Color="{DynamicResource PageColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PanelBrush" Color="{DynamicResource PanelColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{DynamicResource PanelRaisedColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PanelQuietBrush" Color="{DynamicResource PanelQuietColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TopBarBrush" Color="{DynamicResource TopBarColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ElevatedCardBrush" Color="{DynamicResource ElevatedCardColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="ControlSurfaceBrush" Color="{DynamicResource ControlSurfaceColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{DynamicResource HoverSurfaceColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="PressedSurfaceBrush" Color="{DynamicResource PressedSurfaceColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{DynamicResource SelectedSurfaceColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{DynamicResource MutedTextColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{DynamicResource AccentDarkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{DynamicResource DangerDarkColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="MeterTrackBrush" Color="{DynamicResource MeterTrackColor}" po:Freeze="False" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{DynamicResource DisabledColor}" po:Freeze="False" />

    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <Thickness x:Key="PagePadding">24</Thickness>
    <Thickness x:Key="CardPadding">18</Thickness>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <CornerRadius x:Key="ControlRadius">7</CornerRadius>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
