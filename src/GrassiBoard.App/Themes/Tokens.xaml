<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="PageColor">#090E13</Color>
    <Color x:Key="SidebarColor">#0C1219</Color>
    <Color x:Key="PanelColor">#131C26</Color>
    <Color x:Key="PanelRaisedColor">#182431</Color>
    <Color x:Key="PanelQuietColor">#0E161F</Color>
    <Color x:Key="BorderColor">#263746</Color>
    <Color x:Key="TextColor">#F4F7F9</Color>
    <Color x:Key="MutedTextColor">#93A7BA</Color>
    <Color x:Key="AccentColor">#76E7B7</Color>
    <Color x:Key="AccentDarkColor">#163D32</Color>
    <Color x:Key="WarningColor">#F2CF72</Color>
    <Color x:Key="DangerColor">#FF7C92</Color>
    <Color x:Key="DangerDarkColor">#47232C</Color>

    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="{StaticResource PanelRaisedColor}" />
    <SolidColorBrush x:Key="PanelQuietBrush" Color="{StaticResource PanelQuietColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentDarkColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDarkBrush" Color="{StaticResource DangerDarkColor}" />

    <Thickness x:Key="PagePadding">28</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <FontFamily x:Key="MonoFont">Consolas</FontFamily>
</ResourceDictionary>
