[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=08/02/2026,0.6.2.0
CatalogFile=GrassiBoardVirtualAudio.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
GrassiBoardVirtualAudio.sys=1

[SignatureAttributes]
GrassiBoardVirtualAudio.sys=SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel=1300

[Manufacturer]
%ManufacturerName%=GrassiBoard,NTamd64.10.0

[GrassiBoard.NTamd64.10.0]
%DeviceDescription%=GrassiBoard_Install,ROOT\GrassiBoardVirtualAudio

[DestinationDirs]
GrassiBoard_CopyFiles=13

[GrassiBoard_CopyFiles]
GrassiBoardVirtualAudio.sys

[GrassiBoard_Install.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=GrassiBoard_CopyFiles
AddReg=GrassiBoard_AddReg

[GrassiBoard_AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,GrassiBoardVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDescription%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDescription%
HKR,%MediaCategories%\%RenderCustomNameGuid%,Name,,%RenderEndpointName%
HKR,%MediaCategories%\%CaptureCustomNameGuid%,Name,,%CaptureEndpointName%

[GrassiBoard.I.WaveRender]
AddReg=GrassiBoard.I.WaveRender.AddReg
[GrassiBoard.I.WaveRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%RenderEndpointName%

[GrassiBoard.I.TopologyRender]
AddReg=GrassiBoard.I.TopologyRender.AddReg
[GrassiBoard.I.TopologyRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%RenderEndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[GrassiBoard.I.WaveCapture]
AddReg=GrassiBoard.I.WaveCapture.AddReg
[GrassiBoard.I.WaveCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CaptureEndpointName%

[GrassiBoard.I.TopologyCapture]
AddReg=GrassiBoard.I.TopologyCapture.AddReg
[GrassiBoard.I.TopologyCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CaptureEndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
; Windows 10 build 19045 fails to construct the capture Audio Engine graph
; when this WaveRT endpoint opts into pull/event-driven mode. Omit the opt-in
; for capture so PortCls uses its stable timer-driven WaveRT path. Render keeps
; the event-driven capability and continues feeding the same kernel PCM ring.

[GrassiBoard_Install.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveRender%,GrassiBoard.I.WaveRender
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveRender%,GrassiBoard.I.WaveRender
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveRender%,GrassiBoard.I.WaveRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyRender%,GrassiBoard.I.TopologyRender
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyRender%,GrassiBoard.I.TopologyRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveCapture%,GrassiBoard.I.WaveCapture
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveCapture%,GrassiBoard.I.WaveCapture
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveCapture%,GrassiBoard.I.WaveCapture
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyCapture%,GrassiBoard.I.TopologyCapture
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyCapture%,GrassiBoard.I.TopologyCapture

[GrassiBoard_Install.NT.Services]
AddService=GrassiBoardVirtualAudio,0x00000002,GrassiBoard_Service

[GrassiBoard_Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\GrassiBoardVirtualAudio.sys

[GrassiBoard_Install.NT.HW]
AddReg=GrassiBoard_Hardware

[GrassiBoard_Hardware]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[GrassiBoard_Install.NT.Wdf]
KmdfService=GrassiBoardVirtualAudio,GrassiBoard_Wdf

[GrassiBoard_Wdf]
KmdfLibraryVersion=1.15

[Strings]
