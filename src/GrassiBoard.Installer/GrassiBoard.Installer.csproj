<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GrassiBoard-Setup</AssemblyName>
    <RootNamespace>GrassiBoard.Installer</RootNamespace>
    <ApplicationIcon>..\GrassiBoard.App\Assets\GrassiBoard.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\installer.png" />
    <Resource Include="..\GrassiBoard.App\Assets\GrassiBoard.ico" Link="Assets\GrassiBoard.ico" />
    <EmbeddedResource Include="$(PayloadArchive)"
                      LogicalName="GrassiBoardPayload.zip"
                      Condition="'$(PayloadArchive)' != '' and Exists('$(PayloadArchive)')" />
  </ItemGroup>

  <Target Name="RequireInstallerPayload" BeforeTargets="Publish">
    <Error Condition="'$(PayloadArchive)' == '' or !Exists('$(PayloadArchive)')"
           Text="Publish requires -p:PayloadArchive=&lt;absolute portable ZIP path&gt;." />
  </Target>
</Project>
