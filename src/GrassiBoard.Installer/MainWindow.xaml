<Window x:Class="GrassiBoard.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GrassiBoard Setup" Width="960" Height="840"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="#030A1B" Icon="Assets/GrassiBoard.ico">
    <Border BorderBrush="#33547F" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="600" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Background="#040C20" MouseLeftButtonDown="OnTitleBarMouseDown">
                <StackPanel Orientation="Horizontal" Margin="12,0">
                    <Image Source="Assets/GrassiBoard.ico" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="GrassiBoard Setup" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" Width="44" MinWidth="0" Padding="0"
                        Background="Transparent" FontSize="20" Click="OnCloseClick" />
            </Grid>

            <Image Grid.Row="1" Source="Assets/installer.png" Stretch="UniformToFill" />

            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="22,16">
                <Grid>
                    <Grid x:Name="SetupPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock x:Name="SetupTitle" Text="Ready to install GrassiBoard 1.1.0" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock x:Name="CableStatusText" Text="Checking for a compatible virtual audio cable..."
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="DesktopShortcutCheckBox" Content="Desktop shortcut" IsChecked="True"
                                      Foreground="{StaticResource TextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Grid x:Name="InstallPathPanel" Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="InstallPathTextBox" />
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource SecondaryButton}" Click="OnBrowseClick" />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="OnCloseClick" Margin="0,0,10,0" />
                            <Button x:Name="InstallButton" Content="Install" Click="OnInstallClick" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="ProgressPanel" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Installing GrassiBoard..." FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="ProgressStatusText" Text="Preparing files" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                            <ProgressBar x:Name="InstallProgressBar" Height="9" Minimum="0" Maximum="100"
                                         Background="#102342" Foreground="#1BD8A1" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CompletePanel" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="CompleteTitle" Text="GrassiBoard is installed" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="CompleteMessage" Text="The application is ready to open."
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                            <TextBlock x:Name="CableDownloadMessage" Visibility="Collapsed" Margin="0,6,20,0" TextWrapping="Wrap">
                                <Run Text="No compatible virtual cable was detected. " />
                                <Hyperlink NavigateUri="https://download.vb-audio.com/Download_CABLE/VBCABLE_Driver_Pack45.zip"
                                           RequestNavigate="OnCableLinkNavigate">Download VB-CABLE from its publisher</Hyperlink>
                                <Run Text=", extract it, run the x64 setup as Administrator, then restart Windows." />
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource SecondaryButton}" Click="OnCloseClick" Margin="0,0,10,0" />
                            <Button x:Name="OpenButton" Content="Open GrassiBoard" Click="OnOpenClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
