<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRemoteMonitorSpike)' == 'true'">
    <DefineConstants>$(DefineConstants);REMOTE_MONITOR_SPIKE</DefineConstants>
  </PropertyGroup>

  <!--
    The historical full-app smoke Program contains release/baseline assertions that
    evolve independently from an in-progress Looper Gate. For local Gate iteration,
    select a tiny entrypoint while retaining all Looper ModuleInitializer smoke files.
    This lets Gate 1/2/3 deterministic checks run locally without GitHub Actions.
  -->
  <ItemGroup Condition="'$(LooperLocalGateSmoke)' == 'true'">
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(LooperLocalGateSmoke)' != 'true'">
    <Compile Remove="Program.LooperLocal.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GrassiBoard.Shared\GrassiBoard.Shared.csproj" />
    <ProjectReference Include="..\..\src\GrassiBoard.App\GrassiBoard.App.csproj" />
  </ItemGroup>
</Project>
