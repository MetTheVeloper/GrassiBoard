<Project>
  <PropertyGroup>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' == ''">0.3.0+local</InformationalVersion>
    <InformationalVersion Condition="'$(SourceRevisionId)' != ''">0.3.0+$(SourceRevisionId)</InformationalVersion>
    <Company>GrassiBoard</Company>
    <Product>GrassiBoard</Product>
    <Copyright>Copyright © GrassiBoard contributors</Copyright>
    <Authors>GrassiBoard contributors</Authors>
    <RepositoryUrl>https://github.com/MetTheVeloper/GrassiBoard</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TargetPlatform>x64</TargetPlatform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Pinned now so the driver milestone cannot silently choose a different kit. -->
    <WindowsWdkVersion>10.0.28000.1839</WindowsWdkVersion>
    <WindowsSdkVersion>10.0.26100.0</WindowsSdkVersion>
  </PropertyGroup>
</Project>
